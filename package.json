{
  "name": "instacode",
  "displayName": "InstaWP VSCode Extension",
  "publisher": "instawp",
  "description": "Remotely edit WordPress sites on InstaWP inside VSCode",
  "version": "0.13.0",
  "engines": {
    "vscode": "^1.83.0"
  },
  "repository": "https://github.com/InstaWP/instacode",
  "icon": "images/instawp.png",
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./extension.js",
  "browser": "./extension.js",
  "contributes": {
    "uriHandlers": [
      {
        "uri": "instacode",
        "title": "InstaCode URL Handler"
      }
    ],
    "commands": [
      {
        "command": "instacode.connectSFTP",
        "title": "Connect to InstaWP Site"
      },
      {
        "command": "instacode.uploadFile",
        "title": "InstaWP: Upload File"
      },
      {
        "command": "instacode.refreshSftpExplorer",
        "title": "InstaWP: Refresh",
        "icon": "$(refresh)"
      },
      {
        "command": "instacode.createFolder",
        "title": "InstaWP: Create New Folder"
      },
      {
        "command": "instacode.createNewFile",
        "title": "InstaWP: New File"
      }
    ],
    "menus": {
      "view/item/context": [
        {
          "when": "view == sftpExplorer && viewItem == folder",
          "command": "instacode.uploadFile"
        },
        {
          "when": "view == sftpExplorer && viewItem == folder",
          "command": "instacode.createFolder"
        },
        {
          "when": "view == sftpExplorer && viewItem == folder",
          "command": "instacode.createNewFile"
        }
      ],
      "view/title": [
        {
          "command": "instacode.refreshSftpExplorer",
          "when": "view == sftpExplorer",
          "group": "navigation",
          "icon": "$(loading)"
        }
      ]
    },
    "views": {
      "explorer": [
        {
          "id": "sftpExplorer",
          "name": "InstaWP Explorer",
          "title": "InstaWP Explorer"
        }
      ]
    }
  },
  "scripts": {
    "lint": "eslint .",
    "pretest": "npm run lint",
    "test": "node ./test/runTest.js"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.3",
    "@types/node": "18.x",
    "@types/vscode": "^1.83.0",
    "@vscode/test-electron": "^2.3.6",
    "eslint": "^8.52.0",
    "glob": "^10.3.10",
    "mocha": "^10.2.0",
    "typescript": "^5.2.2"
  },
  "dependencies": {
    "axios": "^1.6.0",
    "ssh2": "^1.14.0",
    "ssh2-sftp-client": "^9.1.0"
  }
}
